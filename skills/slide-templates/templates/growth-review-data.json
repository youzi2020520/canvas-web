      "textStrong": { "value": "#0f172a", "usage": "标题文字" },
      "textBody": { "value": "#475569", "usage": "正文文字" },
      "textMuted": { "value": "#94a3b8", "usage": "来源标注/辅助" },
      "border": { "value": "#e2e8f0", "usage": "描边/分割线" }
    }
  },
  "typography": {
    "roles": {
