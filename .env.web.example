# Required for GPT Image 2 / server-side AI
OPENAI_API_KEY=sk-...

# Public domain shown in ChatGPT UI
CODEX_CANVAS_PUBLIC_URL=https://canvas.websyc.tech/

# Persistent directory. Mount this to durable storage in production.
CODEX_CANVAS_WEB_PROJECT_DIR=/var/lib/codex-canvas/default

# Internal listeners behind Nginx
CODEX_CANVAS_WEB_HOST=127.0.0.1
CODEX_CANVAS_WEB_PORT=43217
CODEX_CANVAS_MCP_HOST=127.0.0.1
CODEX_CANVAS_MCP_PORT=8787

# Models
CODEX_CANVAS_IMAGE_MODEL=gpt-image-2
CODEX_CANVAS_TEXT_MODEL=gpt-5.6-luna

# Optional static bearer protection for clients that can send Authorization.
# Leave empty when ChatGPT custom app auth is handled elsewhere (for example OAuth / gateway).
CODEX_CANVAS_MCP_TOKEN=

CODEX_CANVAS_RUNTIME=web
CODEX_CANVAS_REMOTE_MODE=1
